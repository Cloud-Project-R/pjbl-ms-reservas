# Copie este arquivo para ".env" (na pasta pjbl-ms-reservas) e preencha.
# O ".env" NUNCA vai para o GitHub.

# Azure SQL Database
SQL_HOST=sql-pjbl-reservas.database.windows.net
SQL_DATABASE=reservasdb
SQL_USER=pjbladmin
# Use aspas simples se a senha tiver # (sem aspas o # vira comentário). Ex.: SQL_PASSWORD='Abc#123'
SQL_PASSWORD=

# String de conexão da Storage Account (portal: Storage Account > Access keys)
STORAGE_CONNECTION=

# Porta local (na nuvem/Docker o padrão é 3000)
PORT=3002

# Liga o CORS só para testes locais. Na nuvem o CORS fica no API Gateway.
ENABLE_CORS=true
